{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "espidf",
            "name": "Launch",
            "request": "launch",
            "openocd": {
                "command": "${command:espIdf.getOpenOcdCommand}",
                "config": [
                    "interface/ftdi/esp_ftdi.cfg",
                    "target/esp32s3.cfg"
                ],
                "search": [
                    "${command:espIdf.getOpenOcdScripts}"
                ],
                "cwd": "${workspaceFolder}"
            },
            "executable": "${workspaceFolder}/build/${command:espIdf.getProjectName}.elf",
            "symbols": "${workspaceFolder}/build/${command:espIdf.getProjectName}.elf",
            "svd_file": "",
            "port": "43474"
        }
    ]
}